{
  "name": "n8n-nodes-wayza",
  "version": "0.1.0",
  "description": "n8n community node: ask a real person through Wayza and wait for their signed answer.",
  "keywords": [
    "n8n-community-node-package",
    "wayza",
    "human-in-the-loop",
    "approval"
  ],
  "license": "MIT",
  "homepage": "https://wayza.com",
  "main": "index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-icons.js",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "npm run build && node --test test/wayza.test.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/WayzaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Wayza/Wayza.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "author": {
    "name": "Wayza",
    "email": "support@wayza.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayza-protocol/wayza-js.git",
    "directory": "packages/n8n-nodes-wayza"
  },
  "bugs": {
    "url": "https://github.com/wayza-protocol/wayza-js/issues"
  }
}
